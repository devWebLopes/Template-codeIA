generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MECHANIC
  DEALERSHIP
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?  @unique
  name      String?
  role      UserRole @default(OWNER)
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles        Vehicle[]
  vehicleAccesses VehicleAccess[] @relation("UserAccesses")
  requestedAccesses VehicleAccess[] @relation("RequestedByUser")
  maintenancesAsMechanic Maintenance[] @relation("MechanicMaintenances")

  @@index([email])
  @@index([name])
  @@index([createdAt])
  @@index([isActive])
  @@index([role])
}

enum FuelType {
  GASOLINE
  ETHANOL
  DIESEL
  FLEX
  ELECTRIC
}

model Vehicle {
  id             String    @id @default(uuid())
  ownerId        String
  brand          String
  model          String
  year           Int
  licensePlate   String    @unique
  chassisNumber  String?   @unique
  currentMileage Int       @default(0)
  fuelType       FuelType  @default(FLEX)
  purchaseDate   DateTime?
  purchaseValue  Float?
  color          String?
  imageUrl       String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner        User            @relation(fields: [ownerId], references: [id])
  maintenances Maintenance[]
  expenses     Expense[]
  fuelLogs     FuelLog[]
  tires        Tire[]
  documents    VehicleDocument[]
  accesses     VehicleAccess[]

  @@index([ownerId])
  @@index([brand])
  @@index([licensePlate])
  @@index([createdAt])
}

model Maintenance {
  id                      String    @id @default(uuid())
  vehicleId               String
  mechanicId              String?
  date                    DateTime
  type                    String
  description             String
  cost                    Float
  partsUsed               Json?
  mileage                 Int
  nextMaintenanceDate     DateTime?
  nextMaintenanceMileage  Int?
  invoiceUrl              String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  vehicle  Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  mechanic User?   @relation("MechanicMaintenances", fields: [mechanicId], references: [id])

  @@index([vehicleId])
  @@index([date])
  @@index([type])
  @@index([vehicleId, date])
}

enum ExpenseCategory {
  FUEL
  TAX
  INSURANCE
  FINE
  WASH
  PARKING
  MAINTENANCE
  OTHER
}

model Expense {
  id          String          @id @default(uuid())
  vehicleId   String
  date        DateTime
  category    ExpenseCategory
  description String
  value       Float
  receiptUrl  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([date])
  @@index([category])
  @@index([vehicleId, date])
}

enum FuelLogType {
  GASOLINE
  ETHANOL
  DIESEL
  FLEX
}

model FuelLog {
  id            String      @id @default(uuid())
  vehicleId     String
  date          DateTime
  fuelType      FuelLogType
  liters        Float
  pricePerLiter Float
  totalCost     Float
  mileage       Int
  stationName   String?
  fullTank      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([date])
  @@index([vehicleId, date])
}

enum TirePosition {
  FRONT_LEFT
  FRONT_RIGHT
  REAR_LEFT
  REAR_RIGHT
  SPARE
}

model Tire {
  id                    String       @id @default(uuid())
  vehicleId             String
  position              TirePosition
  brand                 String
  model                 String
  size                  String?
  purchaseDate          DateTime
  purchaseMileage       Int
  cost                  Float
  lastRotationDate      DateTime?
  lastRotationMileage   Int?
  expectedLifespanKm    Int?
  expectedLifespanMonths Int?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([position])
}

enum DocumentType {
  IPVA
  LICENSING
  INSURANCE_POLICY
  FINE
  CRLV
  OTHER
}

model VehicleDocument {
  id             String       @id @default(uuid())
  vehicleId      String
  type           DocumentType
  description    String?
  issueDate      DateTime?
  expirationDate DateTime?
  value          Float?
  documentUrl    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([type])
  @@index([expirationDate])
}

enum AccessLevel {
  READ_ONLY
  EDIT_MAINTENANCE
  FULL_ACCESS
}

enum AccessStatus {
  PENDING
  ACTIVE
  REVOKED
}

model VehicleAccess {
  id          String       @id @default(uuid())
  vehicleId   String
  userId      String
  requestedBy String
  accessLevel AccessLevel  @default(READ_ONLY)
  status      AccessStatus @default(PENDING)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  vehicle     Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user        User    @relation("UserAccesses", fields: [userId], references: [id])
  requester   User    @relation("RequestedByUser", fields: [requestedBy], references: [id])

  @@index([vehicleId])
  @@index([userId])
  @@index([status])
  @@index([vehicleId, userId])
}
