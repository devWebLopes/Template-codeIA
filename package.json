{
  "name": "nextjs-saas-template",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "prisma generate && next dev -p 5000 -H 0.0.0.0",
    "dev:tunnel": "vercel dev --tunnel",
    "dev:e2e": "node scripts/dev-e2e.mjs",
    "tunnel": "ngrok http 3000",
    "tunnel:ngrok": "ngrok http 3000",
    "tunnel:cf": "cloudflare tunnel --url http://localhost:3000",
    "env:pull": "vercel env pull .env.local",
    "build": "prisma generate && next build",
    "start": "next start -p 5000 -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "test:unit:watch": "vitest --watch",
    "test:unit:coverage": "vitest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:docker": "node scripts/setup-postgres-docker.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.185",
    "@clerk/backend": "^2.33.3",
    "@clerk/nextjs": "^6.39.3",
    "@eslint/eslintrc": "^3.3.3",
    "@hookform/resolvers": "^5.2.2",
    "@openrouter/ai-sdk-provider": "^1.5.4",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.14",
    "@replit/object-storage": "^1.0.0",
    "@tanstack/react-query": "^5.100.8",
    "@vercel/blob": "^2.3.3",
    "ai": "^5.0.183",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.525.0",
    "next": "^16.2.4",
    "npm": "^11.13.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^9.1.0",
    "recharts": "^2.15.4",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "svix": "^1.92.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.87.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5",
    "vitest": "^4.0.7"
  },
  "overrides": {
    "jsondiffpatch": "^0.7.2"
  }
}
